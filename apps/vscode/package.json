{
  "name": "modelica-studio",
  "displayName": "Modelica Studio OSS",
  "description": "Open-source graphical Modelica editor powered by OpenModelica",
  "version": "0.1.0",
  "publisher": "tetsuji16",
  "license": "MIT",
  "icon": "media/activity-bar.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tetsuji16/vs-modelica"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Machine Learning"
  ],
  "activationEvents": [
    "onLanguage:modelica",
    "workspaceContains:**/*.mo"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "modelica",
        "aliases": [
          "Modelica"
        ],
        "extensions": [
          ".mo"
        ],
        "configuration": "./language/modelica-language-configuration.json",
        "icon": {
          "light": "./media/activity-bar-light.svg",
          "dark": "./media/activity-bar-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "modelica",
        "scopeName": "source.modelica",
        "path": "./language/modelica.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "modelicaStudio",
          "title": "Modelica Studio",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "modelicaStudio": [
        {
          "id": "modelicaStudio.libraries",
          "name": "Libraries"
        },
        {
          "id": "modelicaStudio.models",
          "name": "Models"
        },
        {
          "id": "modelicaStudio.results",
          "name": "Results"
        },
        {
          "id": "modelicaStudio.figures",
          "name": "Figures"
        },
        {
          "id": "modelicaStudio.documents",
          "name": "Documents"
        },
        {
          "id": "modelicaStudio.elements",
          "name": "Elements"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "modelicaStudio.libraries",
        "contents": "No Modelica libraries are loaded yet.\n[Show Environment Status](command:modelicaStudio.showEnvironment)"
      },
      {
        "view": "modelicaStudio.models",
        "contents": "No Modelica models were found in this workspace.\n[New Model](command:modelicaStudio.newModel)\n[New Package](command:modelicaStudio.newPackage)"
      },
      {
        "view": "modelicaStudio.results",
        "contents": "No simulation has produced results yet."
      },
      {
        "view": "modelicaStudio.figures",
        "contents": "No figures have been created yet."
      },
      {
        "view": "modelicaStudio.documents",
        "contents": "No documents are attached to this workspace."
      },
      {
        "view": "modelicaStudio.elements",
        "contents": "Open a Modelica class to inspect its elements."
      }
    ],
    "customEditors": [
      {
        "viewType": "modelicaStudio.diagram",
        "displayName": "Modelica Diagram",
        "selector": [
          {
            "filenamePattern": "*.mo"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "modelicaStudio.open",
        "title": "Open Diagram",
        "category": "Modelica Studio",
        "icon": "$(circuit-board)"
      },
      {
        "command": "modelicaStudio.showEnvironment",
        "title": "Show Environment Status",
        "category": "Modelica Studio",
        "icon": "$(server-environment)"
      },
      {
        "command": "modelicaStudio.checkModel",
        "title": "Check Model",
        "category": "Modelica Studio",
        "icon": "$(check)"
      },
      {
        "command": "modelicaStudio.loadLibrary",
        "title": "Load Library",
        "category": "Modelica Studio",
        "icon": "$(library)"
      },
      {
        "command": "modelicaStudio.refreshLibraries",
        "title": "Refresh Libraries",
        "category": "Modelica Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "modelicaStudio.restartCompiler",
        "title": "Restart Compiler Session",
        "category": "Modelica Studio",
        "icon": "$(debug-restart)"
      },
      {
        "command": "modelicaStudio.revealClass",
        "title": "Reveal Class Source",
        "category": "Modelica Studio"
      },
      {
        "command": "modelicaStudio.searchLibraries",
        "title": "Search Loaded Classes",
        "category": "Modelica Studio",
        "icon": "$(search)"
      },
      {
        "command": "modelicaStudio.clearLibrarySearch",
        "title": "Clear Class Search",
        "category": "Modelica Studio",
        "icon": "$(clear-all)"
      },
      {
        "command": "modelicaStudio.searchModels",
        "title": "Filter Workspace Models",
        "category": "Modelica Studio",
        "icon": "$(search)"
      },
      {
        "command": "modelicaStudio.newModel",
        "title": "New Model",
        "category": "Modelica Studio",
        "icon": "$(new-file)"
      },
      {
        "command": "modelicaStudio.newPackage",
        "title": "New Package",
        "category": "Modelica Studio",
        "icon": "$(new-folder)"
      },
      {
        "command": "modelicaStudio.refreshViews",
        "title": "Refresh Views",
        "category": "Modelica Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "modelicaStudio.simulate",
        "title": "Simulate",
        "category": "Modelica Studio",
        "icon": "$(play)"
      },
      {
        "command": "modelicaStudio.clearResults",
        "title": "Clear Simulation Results",
        "category": "Modelica Studio",
        "icon": "$(clear-all)"
      },
      {
        "command": "modelicaStudio.openResult",
        "title": "Open Result File",
        "category": "Modelica Studio",
        "icon": "$(file)"
      },
      {
        "command": "modelicaStudio.plot",
        "title": "Plot Result",
        "category": "Modelica Studio",
        "icon": "$(chart)"
      },
      {
        "command": "modelicaStudio.ai.propose",
        "title": "AI: Propose Edit",
        "category": "Modelica Studio",
        "icon": "$(sparkle)"
      },
      {
        "command": "modelicaStudio.ai.clearCredentials",
        "title": "AI: Clear Credentials",
        "category": "Modelica Studio"
      },
      {
        "command": "modelicaStudio.mcp.start",
        "title": "MCP: Start stdio server",
        "category": "Modelica Studio"
      },
      {
        "command": "modelicaStudio.mcp.stop",
        "title": "MCP: Stop stdio server",
        "category": "Modelica Studio"
      },
      {
        "command": "modelicaStudio.package.list",
        "title": "Packages: List Libraries",
        "category": "Modelica Studio"
      },
      {
        "command": "modelicaStudio.animate",
        "title": "Open Animation",
        "category": "Modelica Studio",
        "icon": "$(device-camera)"
      },
      {
        "command": "modelicaStudio.debug.start",
        "title": "Debug: Start GDB Session",
        "category": "Modelica Studio"
      },
      {
        "command": "modelicaStudio.debug.step",
        "title": "Debug: Step",
        "category": "Modelica Studio"
      },
      {
        "command": "modelicaStudio.debug.continue",
        "title": "Debug: Continue",
        "category": "Modelica Studio"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "modelicaStudio.open",
          "when": "resourceLangId == modelica",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "modelicaStudio.loadLibrary",
          "when": "view == modelicaStudio.libraries",
          "group": "navigation@1"
        },
        {
          "command": "modelicaStudio.refreshLibraries",
          "when": "view == modelicaStudio.libraries",
          "group": "navigation@2"
        },
        {
          "command": "modelicaStudio.searchLibraries",
          "when": "view == modelicaStudio.libraries",
          "group": "navigation@0"
        },
        {
          "command": "modelicaStudio.clearLibrarySearch",
          "when": "view == modelicaStudio.libraries",
          "group": "navigation@3"
        },
        {
          "command": "modelicaStudio.searchModels",
          "when": "view == modelicaStudio.models",
          "group": "navigation@0"
        },
        {
          "command": "modelicaStudio.newModel",
          "when": "view == modelicaStudio.models",
          "group": "navigation@1"
        },
        {
          "command": "modelicaStudio.newPackage",
          "when": "view == modelicaStudio.models",
          "group": "navigation@2"
        },
        {
          "command": "modelicaStudio.refreshViews",
          "when": "view == modelicaStudio.models || view == modelicaStudio.elements",
          "group": "navigation@3"
        },
        {
          "command": "modelicaStudio.clearResults",
          "when": "view == modelicaStudio.results",
          "group": "navigation@0"
        },
        {
          "command": "modelicaStudio.simulate",
          "when": "view == modelicaStudio.results",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "modelicaStudio.open",
          "when": "resourceLangId == modelica"
        },
        {
          "command": "modelicaStudio.checkModel",
          "when": "resourceLangId == modelica"
        },
        {
          "command": "modelicaStudio.simulate",
          "when": "resourceLangId == modelica"
        },
        {
          "command": "modelicaStudio.showEnvironment"
        },
        {
          "command": "modelicaStudio.restartCompiler"
        },
        {
          "command": "modelicaStudio.revealClass",
          "when": "false"
        },
        {
          "command": "modelicaStudio.searchLibraries"
        },
        {
          "command": "modelicaStudio.clearLibrarySearch"
        },
        {
          "command": "modelicaStudio.searchModels"
        },
        {
          "command": "modelicaStudio.newModel"
        },
        {
          "command": "modelicaStudio.newPackage"
        },
        {
          "command": "modelicaStudio.refreshViews"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "modelica"
      }
    ],
    "debuggers": [
      {
        "type": "modelica-gdb",
        "label": "Modelica GDB (generated simulation)",
        "languages": [
          "modelica"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the compiled simulation executable."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Modelica Studio OSS",
      "properties": {
        "modelicaStudio.omc.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to omc. Empty means OPENMODELICAHOME/PATH auto-detection."
        },
        "modelicaStudio.omc.startupTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Timeout for the OpenModelica version handshake in milliseconds."
        },
        "modelicaStudio.omc.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Timeout for a single OpenModelica scripting call in milliseconds."
        },
        "modelicaStudio.diagnostics.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run loadFile and checkModel when a Modelica file is saved."
        },
        "modelicaStudio.ai.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openrouter"
          ],
          "default": "ollama"
        },
        "modelicaStudio.ai.ollama.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434"
        },
        "modelicaStudio.ai.ollama.model": {
          "type": "string",
          "default": "qwen3-coder"
        },
        "modelicaStudio.ai.openRouter.model": {
          "type": "string",
          "default": ""
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/build-webview.mjs && node tools/build-extension.mjs",
    "build:webview": "node tools/build-webview.mjs",
    "build:extension": "node tools/build-extension.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"unit tests run from the workspace root via vitest\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelica-studio/contracts": "workspace:*",
    "@modelica-studio/modelica": "workspace:*",
    "@modelica-studio/omc": "workspace:*",
    "@modelica-studio/ui": "workspace:*",
    "@modelica-studio/ai": "workspace:*",
    "@modelica-studio/mcp": "workspace:*",
    "@modelica-studio/animation": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  }
}
