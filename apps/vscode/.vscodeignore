# Source and dev-only files that must never ship in the Marketplace package.
**/*.map
**/*.ts
**/tsconfig.json
**/.vscode-test*
**/test/**
**/dist/**/*.map
node_modules/**
.gitignore
**/*.test.ts
tools/**
docs/**

# Only the compiled, bundled extension and media belong in the package.
# `src/` is compiled and bundled into dist/extension.js by tools/build-extension.mjs,
# so the TypeScript sources are not needed at runtime.
!dist/**
!media/**
!language/**
!src/**/*.js
!src/**/*.d.ts
